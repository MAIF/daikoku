# Template for daikoku/.env.stripe (gitignored). Copy it, fill your Stripe test keys, then:
#   mise run dev --mode stripe   dev stack wired to your Stripe test account (needs the Stripe CLI)
#   mise run test:stripe         Playwright billing e2e against real Stripe test mode
# The Scala e2e read the same variables, from a shell where the file is sourced:
#   source daikoku/.env.stripe && cd daikoku && sbt "testOnly fr.maif.daikoku.controllers.StripeE2ESpec fr.maif.daikoku.controllers.StripeWebhookSpec"

# Stripe Dashboard -> Test mode -> Developers -> API keys
export STRIPE_TEST_SECRET_KEY=sk_test_xxxxxxxx
export STRIPE_TEST_PUBLIC_KEY=pk_test_xxxxxxxx
export DAIKOKU_STRIPE_URL=https://api.stripe.com
